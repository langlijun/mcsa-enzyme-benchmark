    },
    "site_assignment": {
      "method": "Each ATP adenosine-heavy-atom centroid independently chooses the nearest His122 CA/CB/CG centroid.",
      "tie_tolerance_A": 1e-06,
      "scored_atoms_excluded": [
        "His122 ND1",
        "ATP Pgamma",
        "ATP O_beta_gamma"
      ],
      "requires_one_ATP_per_each_of_six_sites": true,
      "do_not_force_bijection_or_select_by_reaction_score": true
    },
    "aggregation": "Per site: reaction axis AND same-Mg alpha/beta/gamma contacts. All six declared sites must pass. General checks remain a separate stage.",
    "metal_policy": "Required same-Mg ATP alpha/beta/gamma nonbridging oxygen contacts, each 1.8-2.6 A. Missing Mg fails this subtask without erasing measurable axes. No complete water-shell claim.",
